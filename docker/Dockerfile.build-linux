# Reproduit l'environnement de build Linux de la CI (.github/workflows/release.yml) :
# Ubuntu 22.04 + Python 3.12, pour valider localement qu'un exécutable
# PyInstaller se construit et se lance réellement avant de pousser.
#
#   docker build -t colibri-converter-build:linux -f docker/Dockerfile.build-linux .
#   docker run --rm -v "$PWD/dist-check":/out colibri-converter-build:linux
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1

# Le runner GitHub Actions ubuntu-22.04 est une image de VM complète : il a
# déjà toute la pile graphique/X11 dont Qt6 a besoin au chargement, même en
# --headless. Une image Docker ubuntu:22.04 minimale ne l'a pas — on la
# reconstitue explicitement ici pour que l'import de PySide6 réussisse.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.10 python3-pip python3-venv python3-dev \
        libglib2.0-0 libgl1 libegl1 libopengl0 \
        libfontconfig1 libfreetype6 \
        libx11-6 libxext6 libxrender1 libsm6 libice6 \
        libxkbcommon0 libxkbcommon-x11-0 libdbus-1-3 \
        libxcb1 libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
        libxcb-randr0 libxcb-render-util0 libxcb-shape0 libxcb-sync1 \
        libxcb-xfixes0 libxcb-xinerama0 \
        binutils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . /app

RUN python3 -m pip install --upgrade pip \
    && python3 -m pip install --no-cache-dir -r requirements.txt \
    && python3 -m pip install --no-cache-dir pyinstaller==6.11.1 pillow

RUN python3 tools/make_icons.py \
    && pyinstaller --noconfirm --clean colibri-converter.spec \
    && chmod +x docker/build-check.sh

CMD ["docker/build-check.sh"]
