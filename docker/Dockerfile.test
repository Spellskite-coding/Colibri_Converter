# Image de test pour le développement du moteur de rendu maison (sans
# LibreOffice). Sert à exécuter la suite pytest et à valider le
# fonctionnement réel, hors de la machine hôte — voir CONTRIBUTING/README
# pour l'usage attendu :
#
#   docker build -t colibri-converter-test:debian -f docker/Dockerfile.test .
#   docker run --rm -v "$PWD":/app -w /app colibri-converter-test:debian \
#       python -m pytest tests/ -v
#
# Debian trixie-slim : proche de l'environnement de build CI réel côté
# glibc/Python, sans les paquets LibreOffice qui ne sont plus nécessaires.
FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv \
        fontconfig procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt pyproject.toml /app/
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir reportlab pytest ruff bandit

# Le reste du code est monté en volume au run (-v), pas copié ici : ça évite
# de reconstruire l'image à chaque modification pendant le développement.
CMD ["python3", "-m", "pytest", "tests/", "-v"]
